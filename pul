<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>eRub</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
    --bg-base: #1F2123;
    --bg-appbar: #182037;
    --bg-card: #27292B;
    --bg-card-hover: #2F3134;
    --bg-input: #161819;
    --bg-input-focus: #1F2123;
    --border: #36383B;
    --border-input: #3A3D40;
    --text-primary: #FFFFFF;
    --text-secondary: #A3A7AA;
    --text-muted: #6B7075;
    --accent: #3366FF;
    --accent-hover: #2B55E6;
    --success: #00D68F;
    --danger: #ED455B;
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-pill: 9999px;
    --shadow-card: 0 6px 15px rgba(0,0,0,0.15);
    --shadow-accent: 0 8px 24px rgba(51,102,255,0.25);
}
*, *:before, *:after { box-sizing: border-box; }
* { margin: 0; padding: 0; }
html { -webkit-text-size-adjust: 100%; -webkit-tap-highlight-color: transparent; }
body {
    min-height: 100svh;
    font-family: 'Open Sans', -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-primary);
    background: var(--bg-base);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 16px;
}
button { cursor: pointer; font: inherit; color: inherit; background: 0 0; border: 0; }
input { font: inherit; color: inherit; }
a { color: inherit; text-decoration: none; }
ul, ol { list-style: none; }
h1, h2, h3, h4 { font-size: inherit; font-weight: inherit; }

.app {
    width: 100%;
    max-width: 440px;
    background: var(--bg-base);
    border-radius: var(--radius-lg);
    padding: 20px 16px 24px;
    box-shadow: 0 25px 60px rgba(0,0,0,0.5);
    display: flex;
    flex-direction: column;
    min-height: 600px;
    position: relative;
    overflow: hidden;
}

.appbar {
    background: var(--bg-appbar);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    box-shadow: var(--shadow-card);
}
.appbar-logo {
    width: 40px; height: 40px;
    border-radius: 10px;
    background: linear-gradient(135deg, #1E64FF, #00CBEF);
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 18px; color: #fff;
    flex-shrink: 0;
}
.appbar-title { font-size: 18px; font-weight: 600; }
.appbar-sub { font-size: 12px; color: var(--text-secondary); margin-top: 2px; }

.hero {
    background: linear-gradient(135deg, #3366FF 0%, #1E4DD1 100%);
    border-radius: var(--radius-md);
    padding: 20px 16px;
    margin-bottom: 20px;
    box-shadow: var(--shadow-accent);
}
.hero h2 { font-size: 20px; font-weight: 700; line-height: 1.3; }
.hero p { font-size: 13px; color: rgba(255,255,255,0.85); margin-top: 6px; }
.hero .badge {
    display: inline-block;
    background: var(--success);
    color: #0B3D2A;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    font-size: 11px;
    font-weight: 600;
    margin-top: 10px;
}

.menu {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
}
.menu-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    font-weight: 500;
    transition: background .15s, border-color .15s;
    text-align: left;
    width: 100%;
}
.menu-item:hover { background: var(--bg-card-hover); border-color: #4A4D50; }
.menu-item .icon {
    width: 32px; height: 32px;
    border-radius: 8px;
    background: rgba(51,102,255,0.15);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    color: var(--accent);
}
.menu-item .icon svg { width: 18px; height: 18px; }
.menu-item .arrow { margin-left: auto; color: var(--text-muted); font-size: 18px; }

.btn-primary {
    width: 100%;
    padding: 15px 20px;
    background: var(--accent);
    color: #fff;
    border-radius: var(--radius-md);
    font-size: 15px;
    font-weight: 600;
    transition: background .15s, transform .1s;
    box-shadow: var(--shadow-accent);
}
.btn-primary:hover:not(:disabled) { background: var(--accent-hover); transform: translateY(-1px); }
.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

.btn-back {
    width: 100%;
    padding: 12px;
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 500;
    transition: background .15s, color .15s;
    margin-top: 12px;
}
.btn-back:hover { background: var(--bg-card); color: var(--text-primary); }

.support-btn {
    width: 100%;
    padding: 12px;
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 500;
    margin-top: 12px;
    transition: background .15s, color .15s;
}
.support-btn:hover { background: var(--bg-card); color: var(--accent-hover); }

.form-group { margin-bottom: 16px; }
.form-group label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 8px;
}
.form-group input {
    width: 100%;
    padding: 14px 16px;
    background: var(--bg-input);
    border: 1px solid var(--border-input);
    border-radius: var(--radius-sm);
    font-size: 15px;
    color: var(--text-primary);
    transition: border-color .15s, background .15s;
}
.form-group input::placeholder { color: var(--text-muted); }
.form-group input:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--bg-input-focus);
}
.form-group input:disabled { opacity: 0.5; cursor: not-allowed; }

.page { display: none; flex-direction: column; animation: fadeIn .25s ease; flex: 1; }
.page.active { display: flex; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

.page-title {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    margin-bottom: 6px;
}
.page-sub {
    font-size: 14px;
    color: var(--text-secondary);
    text-align: center;
    margin-bottom: 20px;
}
.page-icon {
    width: 56px; height: 56px;
    margin: 0 auto 12px;
    border-radius: var(--radius-md);
    background: rgba(51,102,255,0.15);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
}
.page-icon svg { width: 28px; height: 28px; }

.card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 16px;
    margin-bottom: 12px;
    box-shadow: var(--shadow-card);
}
.card h3 { font-size: 16px; font-weight: 600; margin-bottom: 6px; }
.card p { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }
.card .num {
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 6px;
}
.card .highlight { color: var(--accent); font-weight: 500; }

.faq-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    margin-bottom: 8px;
}
.faq-item .q { font-size: 15px; font-weight: 600; margin-bottom: 6px; }
.faq-item .a { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }

.code-section {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 16px;
    margin-bottom: 16px;
}
.code-section label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 8px;
}
.code-section input {
    width: 100%;
    padding: 14px 16px;
    background: var(--bg-input);
    border: 1px solid var(--border-input);
    border-radius: var(--radius-sm);
    font-size: 18px;
    color: var(--text-primary);
    margin-bottom: 12px;
    transition: border-color .15s;
    letter-spacing: 6px;
    text-align: center;
}
.code-section input::placeholder { letter-spacing: normal; color: var(--text-muted); }
.code-section input:focus { outline: none; border-color: var(--accent); }

.message {
    margin-top: 12px;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    display: none;
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    animation: fadeIn .25s ease;
}
.message.success {
    display: block;
    background: rgba(0,214,143,0.12);
    color: var(--success);
    border: 1px solid rgba(0,214,143,0.25);
}
.message.error {
    display: block;
    background: rgba(237,69,91,0.12);
    color: var(--danger);
    border: 1px solid rgba(237,69,91,0.25);
}
.message.info {
    display: block;
    background: rgba(51,102,255,0.12);
    color: var(--accent);
    border: 1px solid rgba(51,102,255,0.25);
}

.status-waiting {
    margin-top: 12px;
    padding: 14px;
    background: rgba(51,102,255,0.08);
    border: 1px solid rgba(51,102,255,0.2);
    border-radius: var(--radius-md);
    text-align: center;
    color: var(--accent);
    font-size: 14px;
    display: none;
}
.status-waiting .spinner {
    display: inline-block;
    width: 16px; height: 16px;
    border: 2px solid rgba(51,102,255,0.2);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin .8s linear infinite;
    margin-right: 8px;
    vertical-align: middle;
}
@keyframes spin { to { transform: rotate(360deg); } }

.error-page { text-align: center; padding: 32px 0; }
.error-page .icon {
    width: 72px; height: 72px;
    margin: 0 auto 16px;
    border-radius: 50%;
    background: rgba(237,69,91,0.12);
    display: flex; align-items: center; justify-content: center;
    font-size: 36px; color: var(--danger);
}
.error-page h2 {
    font-size: 24px; font-weight: 700;
    color: var(--danger); margin-bottom: 8px;
}
.error-page p {
    font-size: 15px; color: var(--text-secondary); margin-bottom: 20px;
}

.register-link {
    text-align: center;
    font-size: 14px;
    color: var(--text-secondary);
    margin-top: 16px;
}
.register-link a { color: var(--accent); font-weight: 500; }
.register-link a:hover { text-decoration: underline; }

.footer { margin-top: auto; padding-top: 20px; }

@media (max-width: 420px) {
    .app { padding: 16px 12px 20px; border-radius: var(--radius-md); }
    .page-title { font-size: 22px; }
    .hero h2 { font-size: 18px; }
}
</style>
</head>
<body>

<div class="app">

    <div class="appbar">
        <div class="appbar-logo">e</div>
        <div>
            <div class="appbar-title">eRub</div>
            <div class="appbar-sub">Суверенная криптовалюта</div>
