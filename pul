    <!-- ============ О ПРОЕКТЕ ============ -->
    <div id="pageAbout" class="page">
        <div class="page-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg></div>
